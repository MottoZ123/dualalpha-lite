# DeepSeek compatible chat-completions API
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# Optional Volcengine Ark chat-completions API used by ab_test_DeepSeek.py
VOLCENGINE_API_KEY=replace_with_your_volcengine_api_key
VOLCENGINE_MODEL=replace_with_your_volcengine_endpoint_id
VOLCENGINE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

