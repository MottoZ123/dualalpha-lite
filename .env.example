# Copy this file to .env. Never commit .env or paste keys into Python files.

# Volcengine / Doubao OpenAI-compatible endpoint
VOLCENGINE_API_KEY=
VOLCENGINE_MODEL=ep-your-endpoint-id
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# DeepSeek OpenAI-compatible endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high

LLM_TIMEOUT_SECONDS=240
LLM_MAX_RETRIES=3

# Separately running local Vibe-Research backend
VIBE_RESEARCH_BASE_URL=http://127.0.0.1:8900
VIBE_RESEARCH_API_KEY=
VIBE_RESEARCH_TIMEOUT_SECONDS=20

# This project's API. Leave RESEARCH_API_KEY empty only for localhost use.
RESEARCH_API_KEY=
RESEARCH_ALLOW_ORIGINS=http://127.0.0.1:5899,http://localhost:5899
ENABLE_MODEL_EXECUTION_API=0
ENABLE_TRAINING_API=0
ENABLE_BACKTEST_API=0

# Optional licensed official market feeds. Leave blank to keep the clearly
# labelled commercial-public fallback; never commit subscription credentials.
SSE_OFFICIAL_SNAPSHOT_FILE=
SZSE_OFFICIAL_SNAPSHOT_FILE=
CME_MARKET_DATA_REST_URL=
CME_MARKET_DATA_API_KEY=

# Storage and research rules
RESEARCH_DATA_DIR=
RESEARCH_REPORTS_DIR=
TRAINING_RUNS_DIR=
CONSENSUS_THRESHOLD=0.53
